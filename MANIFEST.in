# The sdist should be enough to rebuild and re-document the project on its own,
# not just enough to install it.
include LICENSE
include README.md
include CONTRIBUTING.md
include CHANGELOG.md
include man/*.1
recursive-include docs *.md
recursive-include docs/adr *.md
include .githooks/*
include scripts/*.py
recursive-include tests *.py
recursive-include tests/fixtures *.list *.md
